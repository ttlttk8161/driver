# 센서 입력 모듈
import queue
import threading
import time
from .data_structures import SensorData
import rospy
from sensor_msgs.msg import Image as RosImage
from sensor_msgs.msg import LaserScan
import logging
from cv_bridge import CvBridge

logger = logging.getLogger(__name__)

class SensorInputManager:
    def __init__(self, config: dict, output_queue: queue.Queue, ros_bridge: CvBridge = None):
        """센서 입력 관리자 초기화"""
        self.config = config
        self.output_queue = output_queue
        self._running = False
        self._thread = None
        self.bridge = ros_bridge
        if self.bridge is None:
            print("SensorInputManager: Warning - CvBridge not provided. ROS Image conversion will fail.")
            logging.warning("SensorInputManager: Warning - CvBridge not provided. ROS Image conversion will fail.")
        self.latest_image_data = None
        self.latest_lidar_data = None
        self.image_timestamp = None
        self.lidar_timestamp = None
        self.lock = threading.Lock() # For thread-safe access to latest_image/lidar_data
        print("SensorInputManager: Initialized.")

    def _ros_image_callback(self, data: RosImage):
        if not self.bridge:
            return
        try:
            cv_image = self.bridge.imgmsg_to_cv2(data, "bgr8")
            with self.lock:
                self.latest_image_data = cv_image
                self.image_timestamp = data.header.stamp.to_sec()
                logger.debug(f"SensorInputManager: Received image data - shape: {cv_image.shape}, timestamp: {self.image_timestamp:.3f}")
        except Exception as e:
            print(f"SensorInputManager: Error converting ROS Image: {e}")
            logging.error(f"SensorInputManager: Error converting ROS Image: {e}")

    def _ros_lidar_callback(self, data: LaserScan):
        with self.lock:
            # Process or store raw ranges as needed by PerceptionModule
            self.latest_lidar_data = list(data.ranges[0:360]) # 예시: 0-359도 범위 사용
            self.lidar_timestamp = data.header.stamp.to_sec()
            logger.debug(f"SensorInputManager: Received lidar data - ranges count: {len(data.ranges)}, timestamp: {self.lidar_timestamp:.3f}")

    def _publish_sensor_data_loop(self):
        """ Periodically checks for new data and puts it on the queue. """
        publish_rate = self.config.get("publish_rate_hz", 10) # Hz
        sleep_duration = 1.0 / publish_rate

        while self._running:
            current_image = None
            current_lidar = None
            img_ts = None
            lid_ts = None
            
            with self.lock:
                if self.latest_image_data is not None:
                    current_image = self.latest_image_data.copy()
                    img_ts = self.image_timestamp
                    # self.latest_image_data = None # Consume on use or allow overwrite
                if self.latest_lidar_data is not None:
                    current_lidar = list(self.latest_lidar_data)
                    lid_ts = self.lidar_timestamp
                    # self.latest_lidar_data = None # Consume on use or allow overwrite
            
            # Ensure both image and lidar data are available before publishing
            # 완화된 조건: 이미지만 있어도 발행 가능
            if current_image is not None:
                final_timestamp = img_ts or time.time() # Default to image timestamp or current time
                if img_ts and lid_ts:
                    if abs(img_ts - lid_ts) > 0.1: # If timestamps are too different (e.g., > 100ms)
                        logger.warning(f"SensorInputManager: Image (ts:{img_ts:.3f}) and LiDAR (ts:{lid_ts:.3f}) timestamps differ significantly. Using newer.")
                    final_timestamp = max(img_ts, lid_ts) # Use the newer timestamp
                elif lid_ts: # Only lidar has timestamp
                    final_timestamp = lid_ts
                
                if final_timestamp is None: # Should not happen if at least one sensor provides data
                    final_timestamp = rospy.Time.now().to_sec() if rospy.Time.now().to_sec() > 0 else time.time() # Use ROS time if available
                    logger.warning("SensorInputManager: Could not determine valid sensor timestamp, using current time.")

                sensor_bundle = SensorData(
                    timestamp=final_timestamp,
                    lidar_data=current_lidar if current_lidar else [],  # 라이다 데이터가 없으면 빈 리스트
                    vision_data=current_image,
                    gnss_data=None, # 실제 GNSS 데이터가 있다면 추가
                    imu_data=None   # 실제 IMU 데이터가 있다면 추가
                )
                try:
                    self.output_queue.put(sensor_bundle, timeout=0.1) # Reduced timeout
                    print(f"SensorInputManager: Published sensor bundle to queue - timestamp: {final_timestamp:.3f}")
                    logger.info(f"SensorInputManager: Published sensor bundle to queue - timestamp: {final_timestamp:.3f}")
                except queue.Full:
                    print("SensorInputManager: Output queue is full. Discarding data.")
                    logging.warning("SensorInputManager: Output queue is full. Discarding data.")
            else:
                # 센서 데이터가 부족할 때의 디버깅 정보
                missing_sensors = []
                if current_image is None:
                    missing_sensors.append("image")
                if current_lidar is None:
                    missing_sensors.append("lidar")
                if missing_sensors:
                    logger.debug(f"SensorInputManager: Waiting for sensor data - missing: {', '.join(missing_sensors)}")
            time.sleep(sleep_duration) 
        print("SensorInputManager: Data publishing loop stopped.") # This print was already here

    def start_sensors(self):
        """Starts the sensor data acquisition thread."""
        if not self._running:
            self._running = True
            # ROS Subscribers
            if self.bridge: # Only subscribe if bridge is available
                rospy.Subscriber("/usb_cam/image_raw", RosImage, self._ros_image_callback, queue_size=1)
                rospy.Subscriber("/scan", LaserScan, self._ros_lidar_callback, queue_size=1)
                print("SensorInputManager: ROS subscribers for Camera and LiDAR started.")
            else:
                print("SensorInputManager: CvBridge not available, ROS subscribers not started. Will use dummy data if _read_and_publish_data is used.")
                logging.warning("SensorInputManager: CvBridge not available, ROS subscribers not started. Will use dummy data if _read_and_publish_data is used.")
            
            # Start the thread that packages and queues data
            self._thread = threading.Thread(target=self._publish_sensor_data_loop, name="SensorDataPublisherThread")
            self._thread.start()
            print("SensorInputManager: Sensors started.")
        else:
            print("SensorInputManager: Sensors already running.")

    def stop_sensors(self):
        """Stops the sensor data acquisition thread."""
        if self._running:
            self._running = False
            if self._thread:
                self._thread.join(timeout=2.0) # Add timeout
            # ROS 구독 해제는 보통 노드 종료 시 자동으로 처리되지만, 명시적으로 할 수도 있음
            # (여기서는 별도 해제 로직 불필요)
            print("SensorInputManager: Sensors stopped.")