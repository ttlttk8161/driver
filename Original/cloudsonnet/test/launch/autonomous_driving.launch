<?xml version="1.0"?>
<launch>
    <!-- Autonomous Driving System Launch File for Xycar -->
    
    <!-- Parameters -->
    <param name="autonomous_driving/fix_speed" value="10" />
    <param name="autonomous_driving/max_angle" value="50" />
    <param name="autonomous_driving/look_ahead_distance" value="3.0" />
    
    <!-- Cost function weights -->
    <param name="autonomous_driving/w_s" value="0.4" />
    <param name="autonomous_driving/w_c" value="0.3" />
    <param name="autonomous_driving/w_d" value="0.3" />
    
    <!-- Safety parameters -->
    <param name="autonomous_driving/max_lateral_acceleration" value="3.0" />
    <param name="autonomous_driving/safety_gain" value="0.5" />
    <param name="autonomous_driving/following_distance_base" value="5.0" />
    
    <!-- Main Autonomous Driving Node -->
    <node name="autonomous_driving_node" pkg="test" type="autonomous_driving_node.py" output="screen">
        <remap from="/usb_cam/image_raw" to="/usb_cam/image_raw" />
        <remap from="/scan" to="/scan" />
        <remap from="/xycar_motor" to="/xycar_motor" />
    </node>
    
    <!-- Optional: RViz for visualization -->
    <!-- 
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find test)/config/autonomous_driving.rviz" />
    -->
    
    <!-- Optional: rqt_image_view for camera debugging -->
    <!--
    <node name="image_view" pkg="rqt_image_view" type="rqt_image_view" />
    -->
    
</launch>
